{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // "paths": {
    //   "@/*": ["./src/*"]
    // }
    "paths": {
      "@/*": ["./src/*"],
      "@repo/design_system": ["../../packages/design_system/src"],
      "@repo/design_system/*": ["../../packages/design_system/src/*"],
      "@repo/design_system/atoms": ["../../packages/design_system/src/atoms"],
      "@repo/design_system/atoms/*": ["../../packages/design_system/src/atoms/*"],
      "@repo/design_system/molecules": ["../../packages/design_system/src/molecules"],
      "@repo/design_system/molecules/*": ["../../packages/design_system/src/molecules/*"],
      "@repo/auth": ["../../packages/auth/src"],
      "@repo/auth/*": ["../../packages/auth/src/*"],
      "@repo/auth-v2": ["../../packages/auth-v2"],
      "@repo/auth-v2/*": ["../../packages/auth-v2/*"],
      "@repo/*": ["../../packages/*/src"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
