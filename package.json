{
  "name": "openldr-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.3.3",
    "typescript": "5.5.4"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^18.3.12",
      "@types/react-dom": "^18.3.1",
      "form-data@4": "^4.0.6",
      "protobufjs@7": "^7.5.6",
      "tar@7": "^7.5.19",
      "lodash@4": "^4.18.0",
      "minimatch@3": "^3.1.3",
      "js-yaml@4": "^4.3.0",
      "nanoid@3": "^3.3.16",
      "ws@8": "^8.21.0",
      "postcss@8": "^8.5.12",
      "jsondiffpatch@0.7": "^0.7.6",
      "socket.io-parser@4": "^4.2.6",
      "linkify-it@5": "^5.0.1",
      "node-fetch@2": "^2.6.7",
      "flatted@3": "^3.4.0",
      "fast-uri@3": "^3.1.4",
      "picomatch@2": "^2.3.2",
      "serialize-javascript@7": "^7.0.3",
      "browserslist@4": "^4.28.7",
      "js-cookie@3": "^3.0.7",
      "@grpc/grpc-js@1": "^1.13.5"
    }
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@esbuild/linux-x64": "^0.25.0",
    "@mui/material": "^6.1.10",
    "date-fns": "2.30.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "paths": {
    "@/*": [
      "./src/*"
    ],
    "@repo/design_system": [
      "../../packages/design_system/src"
    ],
    "@repo/design_system/*": [
      "../../packages/design_system/src/*"
    ],
    "@repo/design_system/atoms": [
      "../../packages/design_system/src/atoms"
    ],
    "@repo/design_system/atoms/*": [
      "../../packages/design_system/src/atoms/*"
    ],
    "@repo/design_system/molecules": [
      "../../packages/design_system/src/molecules"
    ],
    "@repo/design_system/molecules/*": [
      "../../packages/design_system/src/molecules/*"
    ],
    "@repo/auth": [
      "../../packages/auth/src"
    ],
    "@repo/auth/*": [
      "../../packages/auth/src/*"
    ],
    "@repo/*": [
      "../../packages/*/src"
    ]
  }
}
