NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_OPENLDR_API=

# Origin of this admin app. Invitations redirect to it, so a dev deployment must set it
# (otherwise invitations send people to the production admin app).
NEXT_PUBLIC_DASHBOARD_URL_ADMIN=

# Leave unset until the API runs with PERMISSIONS_ENFORCED=1. Set to 1 (and rebuild) to hide the
# "permissions are not being applied yet" notice on the Utilizadores page.
NEXT_PUBLIC_PERMISSIONS_ENFORCED=
